{
  "name": "soccar-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build:wasm",
    "prebuild": "npm run build:wasm",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "test:rust": "cargo test --locked --manifest-path simulation/Cargo.toml",
    "test:simulation": "npm run build:wasm && node scripts/check-simulation.mjs",
    "test:simulation:full": "npm run test:simulation -- --full",
    "test:presentation": "npm run build:wasm && node scripts/check-presentation.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:cli": "node scripts/check-native-cli.mjs",
    "benchmark": "node scripts/benchmark-matches.mjs",
    "sim": "cargo run --release --locked --manifest-path simulation/Cargo.toml --bin soccar_sim --"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "vite": "8.3.1"
  }
}
